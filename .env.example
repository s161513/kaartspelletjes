# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# Restart the server (also `npm run dev`) after editing it.

# Secret for the 67 counter: it is then only at /counter/<COUNTER_KEY>.
# Leave empty to disable the counter. Use a long random, URL-safe value (only
# letters, digits, - and _), without quotes, e.g.
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
COUNTER_KEY=
